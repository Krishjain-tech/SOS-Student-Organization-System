{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "packages/shared/src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
