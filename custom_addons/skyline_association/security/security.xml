<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_skyline" model="ir.module.category">
        <field name="name">Skyline Student Association</field>
        <field name="description">Digital Operating Platform for Skyline Student Association</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_skyline_student" model="res.groups">
        <field name="name">Student / Member</field>
        <field name="category_id" ref="module_category_skyline"/>
    </record>

    <record id="group_skyline_officer" model="res.groups">
        <field name="name">Association Officer / Staff</field>
        <field name="category_id" ref="module_category_skyline"/>
        <field name="implied_ids" eval="[(4, ref('group_skyline_student'))]"/>
    </record>

    <record id="group_skyline_admin" model="res.groups">
        <field name="name">Association Administrator</field>
        <field name="category_id" ref="module_category_skyline"/>
        <field name="implied_ids" eval="[(4, ref('group_skyline_officer')), (4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Student Record Rules: Students can only view their own tickets and orders -->
    <record id="rule_skyline_ticket_student" model="ir.rule">
        <field name="name">Student Ticket Personal Access</field>
        <field name="model_id" ref="model_skyline_ticket"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_skyline_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_skyline_ticket_officer" model="ir.rule">
        <field name="name">Officer Ticket Full Access</field>
        <field name="model_id" ref="model_skyline_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_skyline_officer'))]"/>
    </record>

    <record id="rule_skyline_order_student" model="ir.rule">
        <field name="name">Student Order Personal Access</field>
        <field name="model_id" ref="model_skyline_order"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_skyline_student'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_skyline_order_officer" model="ir.rule">
        <field name="name">Officer Order Full Access</field>
        <field name="model_id" ref="model_skyline_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_skyline_officer'))]"/>
    </record>
</odoo>
