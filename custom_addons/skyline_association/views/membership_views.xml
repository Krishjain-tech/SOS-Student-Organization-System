<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Membership Views -->
    <record id="view_skyline_membership_tree" model="ir.ui.view">
        <field name="name">skyline.membership.tree</field>
        <field name="model">skyline.membership</field>
        <field name="arch" type="xml">
            <tree string="Memberships" decoration-success="status == 'active'" decoration-muted="status == 'expired'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="discount_percent"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-danger="status == 'expired'"/>
                <field name="payment_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_skyline_membership_form" model="ir.ui.view">
        <field name="name">skyline.membership.form</field>
        <field name="model">skyline.membership</field>
        <field name="arch" type="xml">
            <form string="Membership Record">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="status == 'active'"/>
                    <button name="action_expire" string="Mark Expired" type="object" invisible="status == 'expired'"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="plan_name"/>
                            <field name="fee_paid"/>
                            <field name="payment_status"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="discount_percent"/>
                        </group>
                    </group>
                    <group string="Benefits Details">
                        <field name="benefits_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_skyline_membership" model="ir.actions.act_window">
        <field name="name">Student Memberships</field>
        <field name="res_model">skyline.membership</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
