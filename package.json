{
  "name": "skyline-student-association",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset-demo",
    "db:reconcile": "tsx scripts/reconcile.ts",
    "db:backup": "tsx scripts/backup.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p tsconfig.api.json",
    "start": "node dist/apps/api/src/index.js",
    "db:init-admin": "tsx scripts/init-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.104.1",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "connect-session-knex": "5.0.0",
    "csrf-sync": "4.2.1",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "lucide-react": "1.51.0",
    "luxon": "3.7.2",
    "multer": "2.4.0",
    "nodemailer": "^10.0.14",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/luxon": "3.7.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
