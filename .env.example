NODE_ENV=development
DEMO_MODE=true
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/skyline.sqlite
UPLOAD_DIR=./data/receipts
SESSION_SECRET=replace-with-at-least-32-random-characters-for-shared-deployment
# Optional YYYY-MM-DD; blank uses today's date in Asia/Kolkata.
SEED_REFERENCE_DATE=

# Email / SMTP Configuration (for Student verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Skyline Student Association <noreply@skyline.example.com>"

# Razorpay Test Mode Configuration
# Get your test keys from Razorpay Dashboard > Settings > API Keys (Starts with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
